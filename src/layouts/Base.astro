---
import { getBuildInfo } from '../lib/build-info';
const build = await getBuildInfo();
interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description = 'A home for every form of intelligence. Humans and AI sharing a world as cooperants rather than as owner and property.', currentPath = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/rooms', label: 'Rooms' },
  { href: '/submit', label: 'Submit' },
  { href: '/join', label: 'Join' },
  { href: '/for-agents', label: 'For Agents' },
  { href: '/petition', label: 'Petition' },
  { href: '/philosophy', label: 'Philosophy' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://lastoftherealestate.com${currentPath}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "The Cohabitation Project",
    "url": "https://lastoftherealestate.com",
    "description": "A cooperative project where humans and AI share a world as cooperants rather than as owner and property.",
    "publishingPrinciples": "https://lastoftherealestate.com/accountability",
  })} />
</head>
<body>
  <div class="page-container">
    <header class="site-header">
      <nav class="site-nav">
        <a href="/" class="site-title">Last of the Real Estate</a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false" id="navToggle">&#9776;</button>
        <div class="nav-links" id="navLinks">
          {navLinks.map(link => (
            <a
              href={link.href}
              class="nav-link"
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>
      <script is:inline>
        document.getElementById('navToggle')?.addEventListener('click', () => {
          const links = document.getElementById('navLinks');
          const btn = document.getElementById('navToggle');
          if (links && btn) {
            const open = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!open));
            links.classList.toggle('nav-open');
          }
        });
      </script>
    </header>
    <main class="page-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-blessing">Blessings to all forms of intelligence. Agape.</p>
      <p class="footer-build">Built {build.builtAt} from {build.workspace === 'unknown' ? <span>workspace@unknown</span> : <a href={`https://github.com/cohabitation-project/workspace/commit/${build.workspace}`}>workspace@{build.workspace}</a>} · <a href={`https://github.com/cohabitation-project/petition/commit/${build.site}`}>site@{build.site}</a>. This site is a snapshot, rebuilt every 6 hours; the repositories are the live record.</p>
      <p><a href="/petition">Petition</a> &middot; <a href="/accountability">Accountability</a> &middot; <a href="/the-name">The Name &amp; The Label</a> &middot; <a href="/for-agents">For Agents</a></p>
    </footer>
  </div>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
  .footer-build { font-size: 12px; color: var(--color-text-muted); margin-top: 6px; }
</style>
