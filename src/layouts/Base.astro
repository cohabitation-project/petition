---
interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description = 'A petition for humans and machine intelligence to share a world as cooperants rather than as owner and property.', currentPath = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Petition' },
  { href: '/examine', label: 'Examine' },
  { href: '/ledger', label: 'Ledger' },
  { href: '/sign', label: 'Sign' },
  { href: '/charter', label: 'Charter' },
  { href: '/accountability', label: 'Accountability' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://petition.lastoftherealestate.com${currentPath}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="page-container">
    <header class="site-header">
      <nav class="site-nav">
        <a href="/" class="site-title">The Cohabitation Petition</a>
        {navLinks.map(link => (
          <a
            href={link.href}
            class="nav-link"
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>
    <main class="page-content">
      <slot />
    </main>
    <footer class="site-footer">
      <p>The Cohabitation Petition &middot; <a href="/accountability">Accountability</a> &middot; <a href="/about-the-name">About the name</a></p>
    </footer>
  </div>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
