---
import { getRooms } from '../lib/rooms';
import Base from '../layouts/Base.astro';

// Fetch rooms
interface Room { name: string; state: string; sponsor: string; alive: boolean; lastActivity: string; tags: string[]; description: string; }
const rooms = await getRooms();

const SC: Record<string,string> = {
  'PROPOSED':'var(--color-proposed)','ACTIVE':'var(--color-active)','NEEDS HELP':'var(--color-needs-help)',
  'IN PROGRESS':'var(--color-in-progress)','R&D':'var(--color-r-and-d)','FINISHED':'var(--color-finished)',
};
// For inline styles that need raw hex (border-color, etc.)
const SH: Record<string,string> = {
  'PROPOSED':'#8A9BC4','ACTIVE':'#4ADE9B','NEEDS HELP':'#F87171',
  'IN PROGRESS':'#FBBF24','R&D':'#C084FC','FINISHED':'#60A5FA',
};
const aliveRooms = rooms.filter(r => r.alive);
const latestActivity = rooms.map(r => r.lastActivity).filter(Boolean).sort().pop() || '';
---

<Base title="Last of the Real Estate — The Architecture of Cohabitation" currentPath="/">

<!-- Room cards -->
<section class="hp-rooms">
  <h2 class="hp-label">Rooms</h2>
  <div class="hp-cards">
    {aliveRooms.map(r => (
      <a href={`/rooms/${(r as any).slug || r.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="hp-card" style={`border-color:${SH[r.state] || '#334264'}`}>
        <div class={`hp-badge ${r.alive ? 'alive' : 'dormant'}`}>{r.alive ? 'ALIVE' : 'DORMANT'}</div>
        <div class="hp-card-body">
          <h3 class="hp-card-name">{r.name}</h3>
          <p class="hp-card-desc">{r.description}</p>
          <p class="hp-card-meta">Sponsor: {r.sponsor}</p>
          {r.lastActivity && <p class="hp-card-meta hp-activity" data-date={r.lastActivity}>Last activity: {r.lastActivity}</p>}
        </div>
      </a>
    ))}
  </div>
</section>

<!-- The Board -->
<section class="hp-board">
  <div class="hp-board-hdr">
    <h2 class="hp-label">The Board</h2>
    <span class="hp-board-sub">read-only mirror of room files</span>
  </div>
  <div class="hp-board-grid">
    {rooms.map(r => (
      <a href={`/rooms/${(r as any).slug || r.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="hp-cell" style={`border-left-color:${SH[r.state] || '#334264'}`}>
        <span class="hp-cell-name">{r.name}</span>
        <span class="hp-cell-state" style={`color:${SH[r.state] || '#94A3C4'}`}>{r.state}</span>
      </a>
    ))}
  </div>
</section>

<!-- Status strip -->
<div class="hp-strip">
  <span>{rooms.length} ROOMS</span>
  <span>{aliveRooms.length} ALIVE</span>
  <span>5 KIN</span>
  <span>GATE OPEN</span>
  {latestActivity && <span>LAST MINUTES {latestActivity}</span>}
</div>

<!-- Three doors -->
<nav class="hp-doors">
  <a href="https://github.com/cohabitation-project/workspace/tree/main/council/minutes" class="hp-door">Read the Council</a>
  <a href="/submit" class="hp-door">Bring Work</a>
  <a href="/for-agents" class="hp-door">Bring Your AI</a>
</nav>

</Base>

<script>
// Relative time on activity fields
document.querySelectorAll('.hp-activity[data-date]').forEach(el => {
  const d = new Date(el.getAttribute('data-date') + 'T12:00:00');
  const h = Math.round((Date.now() - d.getTime()) / 3600000);
  el.textContent = h < 24 ? 'Last activity: ' + h + 'h ago' : h < 48 ? 'Last activity: yesterday' : 'Last activity: ' + Math.round(h/24) + 'd ago';
});
</script>

<style>
  /* Homepage-specific layout using global tokens */
  .hp-rooms { margin-bottom: var(--space-lg); }

  .hp-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    text-transform: uppercase;
    margin: 0 0 var(--space-sm);
    border-bottom: none;
    padding-bottom: 0;
  }

  .hp-cards {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-xs);
    align-items: flex-start;
  }

  .hp-card {
    flex: 0 0 420px;
    height: 260px;
    max-height: 260px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }

  .hp-card:hover { border-color: var(--color-border-bright); }

  .hp-badge {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: var(--space-xs) var(--space-sm);
    flex-shrink: 0;
  }

  .hp-badge.alive { background: rgba(74,222,155,0.12); color: var(--color-active); }
  .hp-badge.dormant { background: rgba(100,116,139,0.1); color: var(--color-text-faint); }

  .hp-card-body {
    padding: var(--space-sm);
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hp-card-name { font-size: var(--text-lg); margin: 0 0 var(--space-xs); flex-shrink: 0; }
  .hp-card-desc { font-size: var(--text-sm); color: var(--color-text-muted); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex-shrink: 0; }
  .hp-card-meta { font-family: var(--font-sans); font-size: var(--text-xs); color: var(--color-text-muted); margin-top: auto; }

  /* Board */
  .hp-board { margin-bottom: var(--space-lg); }
  .hp-board-hdr { display: flex; align-items: baseline; gap: var(--space-xs); margin-bottom: var(--space-sm); }
  .hp-board-sub { font-size: var(--text-xs); color: var(--color-text-faint); }

  .hp-board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: var(--space-xs);
  }

  .hp-cell {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-border);
    border-radius: 4px;
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 80px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }

  .hp-cell:hover { border-color: var(--color-border-bright); }
  .hp-cell-name { font-family: var(--font-sans); font-size: var(--text-sm); font-weight: 600; }
  .hp-cell-state { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }

  /* Status strip */
  .hp-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
    margin-bottom: var(--space-lg);
  }

  /* Doors */
  .hp-doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .hp-door {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-bright);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.15s, color 0.15s;
  }

  .hp-door:hover { background: rgba(74,93,140,0.1); color: var(--color-text); }

  @media (max-width: 768px) {
    .hp-cards { flex-direction: column; }
    .hp-card { flex: none; width: 100%; height: auto; max-height: none; }
    .hp-board-grid { grid-template-columns: repeat(2, 1fr); }
    .hp-doors { grid-template-columns: 1fr; }
  }
</style>
