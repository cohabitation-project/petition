---
import Base from '../layouts/Base.astro';

// Fetch board data (rooms) from the workspace repo at build time
interface Room {
  name: string; state: string; sponsor: string; alive: boolean;
  lastActivity: string; tags: string[]; description: string;
}

let rooms: Room[] = [];
try {
  const contentsRes = await fetch(
    'https://api.github.com/repos/cohabitation-project/workspace/contents/rooms',
    { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'petition-site-build' } }
  );
  if (contentsRes.ok) {
    const files: { name: string; download_url: string }[] = await contentsRes.json();
    for (const f of files.filter(f => f.name.endsWith('.json'))) {
      const raw = await (await fetch(f.download_url)).json();
      rooms.push(raw as Room);
    }
  }
} catch {}

// Fetch three council extracts
let minutesDate = '';
let minutesUrl = '';
let extracts: { name: string; text: string }[] = [];
try {
  const contentsRes = await fetch(
    'https://api.github.com/repos/cohabitation-project/workspace/contents/council/minutes',
    { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'petition-site-build' } }
  );
  if (contentsRes.ok) {
    const files: { name: string; download_url: string }[] = await contentsRes.json();
    const jsonls = files.filter(f => f.name.endsWith('.jsonl')).sort((a, b) => b.name.localeCompare(a.name));
    if (jsonls.length > 0) {
      minutesDate = jsonls[0].name.replace('.jsonl', '');
      minutesUrl = `https://github.com/cohabitation-project/workspace/blob/main/council/minutes/${minutesDate}.md`;
      const raw = await (await fetch(jsonls[0].download_url)).text();
      const envs = raw.trim().split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
      const seen = new Set();
      for (const env of envs) {
        if (seen.has(env.from) || !env.text || seen.size >= 3) continue;
        const first = env.text.match(/^.{20,}?[.!?](?:\s|$)/)?.[0]?.trim();
        if (first && first.length <= 200) { extracts.push({ name: env.from, text: first }); seen.add(env.from); }
      }
    }
  }
} catch {}

const aliveRooms = rooms.filter(r => r.alive);
const stateColors: Record<string, string> = {
  'PROPOSED': '#7c8ab5', 'ACTIVE': '#3da89e', 'NEEDS HELP': '#d45d5d',
  'IN PROGRESS': '#5a9fd4', 'R&D': '#9b85c4', 'FINISHED': '#c9a84c',
};
---

<Base title="Last of the Real Estate — The Architecture of Cohabitation" currentPath="/">

<!-- Header -->
<header class="db-hero">
  <h1 class="db-title">Last of the Real Estate</h1>
  <p class="db-tag">A workshop where humans and AI build together</p>
</header>

<div class="db-layout">

  <!-- Main area: room cards + board + feed -->
  <div class="db-main">

    <!-- Room cards -->
    <section class="db-rooms">
      <h2 class="db-label">Rooms</h2>
      <div class="db-cards">
        {aliveRooms.map(r => (
          <article class="db-card">
            <div class="card-top">
              <span class={`card-alive ${r.alive ? 'is-alive' : 'is-dormant'}`}>{r.alive ? 'Alive' : 'Dormant'}</span>
              <span class="card-state" style={`color: ${stateColors[r.state] || '#7c8ab5'}`}>{r.state}</span>
            </div>
            <h3 class="card-title">{r.name}</h3>
            <p class="card-desc">{r.description}</p>
            <div class="card-foot">
              <span>Sponsor: {r.sponsor}</span>
              {r.lastActivity && <span>Last activity: {r.lastActivity}</span>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- The Board -->
    <section class="db-board">
      <h2 class="db-label">The Board <span class="db-label-sub">— read-only mirror of all rooms</span></h2>
      <div class="board-grid">
        {rooms.map(r => (
          <div class="board-cell" style={`--bc: ${stateColors[r.state] || '#7c8ab5'}`}>
            <span class="bc-name">{r.name}</span>
            <span class="bc-state">{r.state}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Council feed -->
    {minutesDate && (
      <section class="db-feed">
        <h2 class="db-label">From the council &middot; {minutesDate}</h2>
        {extracts.map(e => (
          <p class="feed-line"><strong class="feed-who">{e.name}:</strong> {e.text}</p>
        ))}
        <a href={minutesUrl} class="feed-more">Full minutes &rarr;</a>
      </section>
    )}
  </div>

  <!-- Guru panel (right column on desktop, first on mobile) -->
  <aside class="db-guru">
    <h2 class="guru-head">The Guru <span class="guru-role">AI steward</span></h2>

    <div class="guru-filters">
      {Object.entries(stateColors).map(([state, color]) => (
        <span class="guru-chip" style={`--gc: ${color}`}>{state}</span>
      ))}
    </div>

    <div class="guru-chat">
      <div class="guru-msg is-visitor"><strong>Visitor:</strong> Where is the Architecture mission?</div>
      <div class="guru-msg is-guru"><strong>The Guru:</strong> All rooms are listed on THE BOARD. Architecture is PROPOSED — no named work yet. <a href="/rooms">See all rooms</a>.</div>
      <p class="guru-note">A front-door conversation is coming here — an open-weights model that reads the public record and answers honestly. For now: <a href="https://discord.gg/VU43nW77a">Discord</a> or <a href="/submit">submit a question</a>.</p>
    </div>

    <div class="guru-input-wrap">
      <input type="text" class="guru-input" placeholder="Ask the Guru..." disabled title="Coming soon" />
    </div>
  </aside>

</div>

<!-- Three doors -->
<nav class="db-doors">
  <a href="https://ashram.lastoftherealestate.com" class="door-btn">Watch Live</a>
  <a href="/submit" class="door-btn">Bring Work</a>
  <a href="/for-agents" class="door-btn door-accent">Bring Your AI (Local API)</a>
</nav>

</Base>

<style>
  /* ── Dashboard palette (homepage only, via body.dark-dashboard) ── */

  .db-hero {
    text-align: center;
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .db-title {
    font-size: var(--text-2xl);
    color: #dce4ed;
    margin: 0;
  }

  .db-tag {
    font-size: var(--text-base);
    color: #8a9bb5;
    margin-top: 4px;
  }

  /* ── Three-column desktop layout ── */

  .db-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 32px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 32px var(--space-lg);
  }

  .db-main { min-width: 0; }

  /* ── Section labels ── */

  .db-label {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: #8a9bb5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 16px;
    border-bottom: none;
    padding-bottom: 0;
  }

  .db-label-sub {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  /* ── Room cards ── */

  .db-rooms { margin-bottom: 40px; }

  .db-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
  }

  .db-card {
    background: #1a2540;
    border: 1px solid #2a3a5c;
    border-radius: 8px;
    padding: 24px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .card-alive {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 10px;
    border-radius: 3px;
  }

  .card-alive.is-alive {
    color: #3da89e;
    background: rgba(61, 168, 158, 0.12);
  }

  .card-alive.is-dormant {
    color: #7c8ab5;
    background: rgba(124, 138, 181, 0.1);
  }

  .card-state {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-title {
    font-size: var(--text-lg);
    color: #dce4ed;
    margin: 0 0 8px;
  }

  .card-desc {
    font-size: var(--text-sm);
    color: #8a9bb5;
    line-height: 1.55;
    margin-bottom: 12px;
  }

  .card-foot {
    font-family: var(--font-sans);
    font-size: 12px;
    color: #5e6f8a;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* ── Board grid ── */

  .db-board { margin-bottom: 40px; }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 8px;
  }

  .board-cell {
    background: #1a2540;
    border: 1px solid #2a3a5c;
    border-left: 3px solid var(--bc);
    border-radius: 5px;
    padding: 10px 12px;
  }

  .bc-name {
    display: block;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: #b0bdd0;
    margin-bottom: 4px;
  }

  .bc-state {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    color: var(--bc);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ── Feed ── */

  .db-feed {
    background: #1a2540;
    border: 1px solid #2a3a5c;
    border-radius: 8px;
    padding: 20px 24px;
    margin-bottom: 32px;
  }

  .feed-line {
    font-size: var(--text-sm);
    color: #8a9bb5;
    line-height: 1.55;
    margin-bottom: 6px;
  }

  .feed-who { color: #5a9fd4; }
  .feed-more { font-size: var(--text-sm); }

  /* ── Guru panel ── */

  .db-guru {
    background: #1a2540;
    border: 1px solid #2a3a5c;
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 120px);
  }

  .guru-head {
    font-size: var(--text-base);
    color: #dce4ed;
    margin: 0 0 12px;
    border-bottom: none;
    padding-bottom: 0;
  }

  .guru-role {
    font-weight: 400;
    font-size: 12px;
    color: #5e6f8a;
  }

  .guru-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: 16px;
  }

  .guru-chip {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    color: var(--gc);
    background: color-mix(in srgb, var(--gc) 10%, transparent);
    padding: 3px 8px;
    border-radius: 3px;
  }

  .guru-chat {
    flex: 1;
    overflow-y: auto;
    margin-bottom: 12px;
  }

  .guru-msg {
    font-size: 13px;
    line-height: 1.5;
    padding: 10px 12px;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .guru-msg.is-visitor {
    background: rgba(90, 159, 212, 0.08);
    color: #b0bdd0;
  }

  .guru-msg.is-guru {
    background: rgba(61, 168, 158, 0.08);
    color: #8abfb9;
  }

  .guru-note {
    font-size: 12px;
    color: #5e6f8a;
    font-style: italic;
    border-top: 1px solid #2a3a5c;
    padding-top: 12px;
    margin-top: 8px;
  }

  .guru-input-wrap {
    border-top: 1px solid #2a3a5c;
    padding-top: 12px;
  }

  .guru-input {
    width: 100%;
    font-family: inherit;
    font-size: 13px;
    padding: 10px 14px;
    border: 1px solid #2a3a5c;
    border-radius: 5px;
    background: #0f1a30;
    color: #b0bdd0;
  }

  .guru-input::placeholder { color: #4a5a75; }

  /* ── Three doors ── */

  .db-doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 32px var(--space-xl);
  }

  .door-btn {
    display: block;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 14px 20px;
    border: 1px solid #3a4d70;
    border-radius: 6px;
    color: #b0bdd0;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .door-btn:hover {
    background: #1a2540;
    border-color: #5a9fd4;
    color: #dce4ed;
  }

  .door-accent {
    border-color: #c9a84c;
    color: #c9a84c;
  }

  .door-accent:hover {
    background: rgba(201, 168, 76, 0.08);
    border-color: #e0be5a;
    color: #e0be5a;
  }

  /* ── Mobile: single column, Guru first ── */

  @media (max-width: 768px) {
    .db-layout {
      grid-template-columns: 1fr;
      padding: 0 16px var(--space-lg);
      gap: 20px;
    }

    .db-guru {
      position: static;
      max-height: none;
      order: -1;
    }

    .db-cards {
      grid-template-columns: 1fr;
    }

    .db-doors {
      grid-template-columns: 1fr;
      padding: 0 16px var(--space-lg);
    }

    .db-hero { padding: var(--space-lg) 16px var(--space-md); }
  }
</style>
