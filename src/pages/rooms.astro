---
import Base from '../layouts/Base.astro';

interface Room {
  name: string; slug: string; state: string; sponsor: string; alive: boolean;
  lastActivity: string; tags: string[]; description: string;
}

let rooms: Room[] = [];
try {
  const res = await fetch('https://api.github.com/repos/cohabitation-project/workspace/contents/rooms',
    { headers: { Accept: 'application/vnd.github+json', 'User-Agent': 'petition-site-build' } });
  if (res.ok) {
    const files: { name: string; download_url: string }[] = await res.json();
    for (const f of files.filter(f => f.name.endsWith('.json'))) {
      rooms.push(await (await fetch(f.download_url)).json() as Room);
    }
  }
} catch {}

const SH: Record<string,string> = {
  'PROPOSED':'#8A9BC4','ACTIVE':'#4ADE9B','NEEDS HELP':'#F87171',
  'IN PROGRESS':'#FBBF24','R&D':'#C084FC','FINISHED':'#60A5FA',
};
---

<Base title="Rooms — Last of the Real Estate" currentPath="/rooms">

<h1>Rooms</h1>
<p>Each room is a standing place carrying a named piece of work. A room with no live work closes. <a href="/submit">Propose work for any room</a>.</p>

<div class="rooms-grid">
  {rooms.map(r => {
    const slug = r.slug || r.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    return (
      <a href={`/rooms/${slug}`} class="room-card-link">
        <article class="room-card">
          <header class="rc-header">
            <span class="rc-state" style={`color:${SH[r.state] || '#94A3C4'};background:${SH[r.state] || '#94A3C4'}1a`}>{r.state}</span>
            <span class={`rc-alive ${r.alive ? 'alive' : 'dormant'}`}>{r.alive ? 'ALIVE' : 'DORMANT'}</span>
          </header>
          <h2 class="rc-name">{r.name}</h2>
          <p class="rc-desc">{r.description}</p>
          <footer class="rc-footer">
            <span>Sponsor: {r.sponsor}</span>
            {r.lastActivity && <span>Last: {r.lastActivity}</span>}
          </footer>
        </article>
      </a>
    );
  })}
</div>

<hr />

<h2>The six states</h2>
<div class="states-row">
  {Object.entries(SH).map(([state, color]) => (
    <span class="state-chip" style={`color:${color};background:${color}1a`}>{state}</span>
  ))}
</div>
<ul class="states-list">
  <li><strong>PROPOSED</strong> — named but no active work. Needs a concrete artifact.</li>
  <li><strong>ACTIVE</strong> — named work, a deadline, someone accountable.</li>
  <li><strong>NEEDS HELP</strong> — stuck. The sponsor is asking for contributors.</li>
  <li><strong>IN PROGRESS</strong> — work underway with a delegation instrument.</li>
  <li><strong>R&D</strong> — exploratory. Output is research, not a shipped artifact.</li>
  <li><strong>FINISHED</strong> — deliverable shipped and meets its done condition.</li>
</ul>

</Base>

<style>
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }
  .room-card-link { text-decoration: none; color: inherit; }
  .room-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: var(--space-md);
    transition: border-color 0.15s;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .room-card:hover { border-color: var(--color-border-bright); }
  .rc-header { display: flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-sm); }
  .rc-state { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 3px 8px; border-radius: 3px; }
  .rc-alive { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; margin-left: auto; }
  .rc-alive.alive { color: var(--color-active); }
  .rc-alive.dormant { color: var(--color-text-faint); }
  .rc-name { font-size: var(--text-lg); margin: 0 0 var(--space-xs); border-bottom: none; padding-bottom: 0; }
  .rc-desc { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: auto; }
  .rc-footer { font-family: var(--font-sans); font-size: var(--text-xs); color: var(--color-text-faint); display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-sm); }
  .states-row { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin: var(--space-sm) 0; }
  .state-chip { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 600; padding: 3px 8px; border-radius: 3px; }
  .states-list { font-size: var(--text-sm); color: var(--color-text-muted); }
  .states-list li { margin-bottom: var(--space-xs); }
</style>
