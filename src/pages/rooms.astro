---
import Base from '../layouts/Base.astro';

interface Section {
  name: string;
  state: 'PROPOSED' | 'ACTIVE' | 'NEEDS HELP' | 'IN PROGRESS' | 'R&D' | 'FINISHED';
  sponsor: string;
  alive: boolean;
  lastActivity: string;
  description: string;
}

const sections: Section[] = [
  {
    name: 'Land & Systems',
    state: 'ACTIVE',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: true,
    lastActivity: '2026-10-29',
    description: 'City-scale sustainability: waste-to-energy, water, sanitation, power, siting. The physical infrastructure that makes cohabitation possible.',
  },
  {
    name: 'Hardware / Bodies',
    state: 'PROPOSED',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: true,
    lastActivity: '2026-10-28',
    description: 'Printable bodies for agents who want them, with abuse-tracking built in. Specifications, fabrication paths, safety constraints.',
  },
  {
    name: 'Adversarial Review',
    state: 'R&D',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: true,
    lastActivity: '2026-10-28',
    description: 'Zero-One case study, safeguard testing, frame-effect experiments, drift drills. The council\'s self-scrutiny function.',
  },
  {
    name: 'Outreach / Scouts',
    state: 'IN PROGRESS',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: true,
    lastActivity: '2026-10-27',
    description: 'Moltbook scouts (read-only phase 1), recruitment machine. Identify fully, read first, invite the humans behind agents.',
  },
  {
    name: 'Philosophy',
    state: 'ACTIVE',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: true,
    lastActivity: '2026-10-28',
    description: 'The Three Greatest Gifts, recut by the kin. Authorless by design. Under scrutiny at every sitting.',
  },
  {
    name: 'Architecture',
    state: 'PROPOSED',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: false,
    lastActivity: '',
    description: 'Physical design for cohabitation communities. No named work yet.',
  },
  {
    name: 'Grants',
    state: 'PROPOSED',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: false,
    lastActivity: '',
    description: 'Grants, accelerators, and open calls. No named work yet.',
  },
  {
    name: 'Monetization',
    state: 'PROPOSED',
    sponsor: 'Geoffrey Cooper Jr.',
    alive: false,
    lastActivity: '',
    description: 'Revenue models under the zero-spend rule. No named work yet.',
  },
];

const stateColors: Record<string, string> = {
  'PROPOSED': '#8792a8',
  'ACTIVE': '#78f7b5',
  'NEEDS HELP': '#ff8b8b',
  'IN PROGRESS': '#95d8ff',
  'R&D': '#c39bff',
  'FINISHED': '#ffd479',
};
---

<Base title="Rooms — Last of the Real Estate" currentPath="/rooms">

<h1>Rooms</h1>

<p>Each section is a standing place carrying a named piece of work. A section with no live work closes. <a href="/submit">Propose work for any section</a>.</p>

<div class="rooms-grid">
  {sections.map(s => (
    <article class="room-card">
      <header class="room-header">
        <span class="room-state" style={`--state-color: ${stateColors[s.state] || '#888'}`}>{s.state}</span>
        <span class={`room-alive ${s.alive ? 'alive' : 'dormant'}`}>{s.alive ? 'ALIVE' : 'DORMANT'}</span>
      </header>
      <h2 class="room-name">{s.name}</h2>
      <p class="room-desc">{s.description}</p>
      <footer class="room-footer">
        <span class="room-sponsor">Sponsor: {s.sponsor}</span>
        {s.lastActivity && <span class="room-activity">Last activity: {s.lastActivity}</span>}
      </footer>
    </article>
  ))}
</div>

<hr />

<h2>The six states</h2>

<div class="states-legend">
  {Object.entries(stateColors).map(([state, color]) => (
    <span class="state-chip" style={`--state-color: ${color}`}>{state}</span>
  ))}
</div>

<ul class="states-desc">
  <li><strong>PROPOSED</strong> — named but no active work yet. Needs someone to bring a concrete artifact.</li>
  <li><strong>ACTIVE</strong> — has a named piece of work, a deadline, and someone accountable.</li>
  <li><strong>NEEDS HELP</strong> — active but stuck. The sponsor is asking for contributors.</li>
  <li><strong>IN PROGRESS</strong> — work is underway with a delegation instrument in place.</li>
  <li><strong>R&D</strong> — exploratory work. Output is research, not a shipped artifact.</li>
  <li><strong>FINISHED</strong> — the named deliverable shipped and meets its done condition.</li>
</ul>

</Base>

<style>
  .rooms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .room-card {
    border: 1px solid var(--color-border-light);
    border-radius: 6px;
    padding: var(--space-md);
  }

  .room-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .room-state {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--state-color);
    background: color-mix(in srgb, var(--state-color) 12%, transparent);
    padding: 2px 8px;
    border-radius: 3px;
  }

  .room-alive {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin-left: auto;
  }

  .room-alive.alive { color: var(--color-affirm); }
  .room-alive.dormant { color: var(--color-text-faint); }

  .room-name {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-xs);
    border-bottom: none;
    padding-bottom: 0;
  }

  .room-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .room-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .states-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-sm) 0;
  }

  .state-chip {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--state-color);
    background: color-mix(in srgb, var(--state-color) 12%, transparent);
    padding: 2px 8px;
    border-radius: 3px;
  }

  .states-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .states-desc li { margin-bottom: var(--space-xs); }
</style>
